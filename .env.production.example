# ── Apex Argus — Production Environment Template ─────────────────────────────
# Copy to .env before running docker-compose.prod.yml
#
#   cp .env.production.example .env
#
# Required fields are marked [REQUIRED]. All others have safe defaults.

# ── Authentication [REQUIRED for shared deployments] ─────────────────────────
AUTH_ENABLED=true

# Generate with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX_FROM_OPENSSL

# Strong passwords for built-in accounts
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
ANALYST_PASSWORD=REPLACE_WITH_STRONG_ANALYST_PASSWORD

# ── Database [REQUIRED] ───────────────────────────────────────────────────────
# PostgreSQL — the prod compose creates the DB automatically via POSTGRES_* vars.
DATABASE_URL=postgresql+asyncpg://apex:REPLACE_WITH_DB_PASSWORD@postgres:5432/apex

# These must match DATABASE_URL above (used by the postgres service itself)
POSTGRES_DB=apex
POSTGRES_USER=apex
POSTGRES_PASSWORD=REPLACE_WITH_DB_PASSWORD

# ── Enforcement mode ──────────────────────────────────────────────────────────
# "dry"  → log decisions only (safe default — strongly recommended).
# "live" → execute real iptables/pfctl rules (REQUIRES isolated VM + root).
ENFORCE_MODE=dry

# ── Organisation name ─────────────────────────────────────────────────────────
# Printed on compliance PDF reports.
ORG_NAME=Your Organization Name

# ── Traffic profile ───────────────────────────────────────────────────────────
# "org" → segmented network with time-of-day variation (recommended for demo)
# "default" → simple mixed traffic
TRAFFIC_PROFILE=org

# ── Demo / showcase mode ──────────────────────────────────────────────────────
# Set to true only for live demonstrations — leaves auto-attack loop running.
DEMO_MODE=false
DEMO_INTERVAL_SECONDS=150

# ── Frontend ──────────────────────────────────────────────────────────────────
# Change to your server's public hostname or IP.
# This is baked into the frontend bundle at build time — rebuild the image if changed.
VITE_API_BASE=http://YOUR_SERVER_IP_OR_HOSTNAME:8000

# ── Optional: LLM incident summaries ─────────────────────────────────────────
# Leave blank to disable gracefully — all other features work without it.
ANTHROPIC_API_KEY=

# ── Optional: Threat Intelligence ────────────────────────────────────────────
# Both are free tiers. Without keys the service falls back to local blocklist.
ABUSEIPDB_API_KEY=     # free at abuseipdb.com  (1000 req/day)
VIRUSTOTAL_API_KEY=    # free at virustotal.com (500 req/day)

# ── Optional: Slack notifications ────────────────────────────────────────────
# Create an Incoming Webhook in Slack → Apps → Incoming Webhooks → Add to Slack
SLACK_WEBHOOK_URL=     # https://hooks.slack.com/services/XXX/YYY/ZZZ

# ── Optional: Email notifications (SMTP) ─────────────────────────────────────
# Gmail: enable 2-FA, generate an App Password at myaccount.google.com/apppasswords
SMTP_HOST=             # smtp.gmail.com
SMTP_PORT=587
SMTP_USER=             # your.email@gmail.com
SMTP_PASS=             # app password (NOT account password)
ALERT_EMAIL_TO=        # soc-team@example.com

# ── Sensor agent (if deployed separately) ────────────────────────────────────
SENSOR_MODE=demo
SENSOR_INTERFACE=eth0
BACKEND_URL=http://localhost:8000
SENSOR_INTERVAL=5
