# ── Anthropic / LLM ──────────────────────────────────────────────────────────
# Required only for Phase 10 LLM incident summaries.
# Leave blank to disable LLM features gracefully.
ANTHROPIC_API_KEY=

# ── Authentication ────────────────────────────────────────────────────────────
# Set to "true" to enforce JWT auth on all protected endpoints.
# When "false" (default), the API is open — existing dashboard works without login.
AUTH_ENABLED=false

# Secret used to sign JWTs. Change this to a long random string in production.
JWT_SECRET=change-this-secret-in-production

# Default user passwords (only used when AUTH_ENABLED=true).
ADMIN_PASSWORD=adminpass
ANALYST_PASSWORD=analystpass

# ── Enforcement mode ──────────────────────────────────────────────────────────
# "dry" → log decisions only (safe default).
# "live" → execute real iptables/pfctl rules (requires root + isolated VM).
ENFORCE_MODE=dry

# ── Demo / showcase mode ─────────────────────────────────────────────────────
# Set DEMO_MODE=true to start the scheduled demo loop automatically on boot.
# Can also be toggled at runtime via POST /api/demo/enable|disable.
DEMO_MODE=false
# Firing cadence in seconds — clamped to 120–300.
DEMO_INTERVAL_SECONDS=150

# ── Database (Phase 2) ───────────────────────────────────────────────────────
# PostgreSQL is the primary store; CSV/JSONL remain the fallback.
# Local dev without Docker → use the SQLite async URL (zero setup):
#   DATABASE_URL=sqlite+aiosqlite:///./apex.db
DATABASE_URL=postgresql+asyncpg://apex:apexpass@localhost:5432/apex

# ── Threat Intelligence (Phase 2) ────────────────────────────────────────────
# Both optional — without keys the service falls back to the local blocklist.
ABUSEIPDB_API_KEY=           # free at abuseipdb.com (1000 req/day)
VIRUSTOTAL_API_KEY=          # free at virustotal.com (4 req/min, 500/day)

# ── Traffic profile ──────────────────────────────────────────────────────────
# "default" → original synthetic mix (normal + one weighted attack per cycle).
# "college" → CollegeNetworkProfile: time-of-day volume, campus subnets, and a
#             target_zone field on each row for the Network Map page.
TRAFFIC_PROFILE=college

# ── Sensor Agent (optional — sensor_agent.py) ────────────────────────────────
# Bridge between the simulation and a real network. See README → Sensor Agent.
# demo → replay synthetic generators; real → live capture via pyshark (needs root).
SENSOR_MODE=demo
SENSOR_INTERFACE=eth0
BACKEND_URL=http://localhost:8000
SENSOR_INTERVAL=5

# ── Frontend build (docker-compose only) ─────────────────────────────────────
# URL the browser uses to reach the backend API.
# Change to your server's public hostname/IP if deploying remotely.
VITE_API_BASE=http://localhost:8000
